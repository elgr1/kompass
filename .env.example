# Copy to .env and fill in. .env is gitignored; never commit it.

# Canvas (Studium) API. The API answers on uppsala.instructure.com;
# studium.uu.se only redirects to a login landing page.
CANVAS_BASE_URL=https://uppsala.instructure.com
# Studium -> Konto -> Inställningar -> Godkända integrationer -> "+ Ny åtkomsttoken"
CANVAS_TOKEN=

# Schedule: TimeEdit -> your schedule -> "Prenumerera" (one or more .ics URLs, comma separated)
TIMEEDIT_ICS_URLS=

# Fallback, only used when CANVAS_TOKEN is empty:
# Studium -> Kalender -> "Kalenderflöde" (private .ics URL)
CANVAS_ICS_URL=

# Notifications. Default on macOS: "mac" (local notification, nothing leaves the computer).
# Comma separated: mac, ntfy, telegram. ntfy/telegram send the notification text to that service.
NOTIFY_CHANNELS=mac
# NTFY_URL=https://ntfy.sh/<a-long-secret-topic-name>
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Reading PDF files from Studium (text only, for search and deadline detection). Set to 0 to turn off.
# KOMPASS_PDF=0

# Optional AI reading of texts the rules cannot interpret. OFF unless BOTH lines below are set.
# Even when on, nothing is sent until you tick texts on the preview page (Hittat -> AI) and approve.
# What is sent: the chosen text, its title and posting date. Sent to: Anthropic's API.
LLM_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
