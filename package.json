{
  "name": "kompass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first study & life command center synced with Studium (Canvas)",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1 -p 3210",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1 -p 3210",
    "demo": "npm run -s seed:demo && NEXT_TELEMETRY_DISABLED=1 KOMPASS_DEMO=1 next dev -H 127.0.0.1 -p 3211",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "token:paste": "node scripts/set-token.ts && npm run -s verify:canvas",
    "verify:canvas": "node --env-file-if-exists=.env scripts/verify-canvas.ts",
    "detect": "tsx --env-file-if-exists=.env scripts/detect.ts",
    "pdf": "tsx --env-file-if-exists=.env scripts/pdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
